# Origins of the three apps, used for cross-app links (no localhost is hard-coded in source).
# Each app ships its own `.env` with the local dev values; override per environment with `.env.local`.
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_DOCTOR_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
